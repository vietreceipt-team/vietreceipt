{
  "name": "vietreceipt-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "typecheck": "tsc --project jsconfig.json && tsc --project jsconfig.v2.json",
    "lint": "node scripts/check-source.js --lint",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
