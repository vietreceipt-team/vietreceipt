{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TV5 original-source evaluation plan; pending structure is not approval",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_family",
    "dataset_snapshot",
    "split",
    "synthetic",
    "authorized",
    "sample_count",
    "frozen",
    "frozen_at",
    "qa_status",
    "protocol",
    "records",
    "split_registry"
  ],
  "properties": {
    "schema_version": {
      "const": "backend-source-evaluation-1.0"
    },
    "dataset_family": {
      "type": "string",
      "minLength": 1
    },
    "dataset_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "benchmark"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "authorized": {
      "type": "boolean"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "frozen": {
      "type": "boolean"
    },
    "frozen_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "qa_status": {
      "enum": [
        "PENDING_REVIEW",
        "VERIFIED"
      ]
    },
    "protocol": {
      "type": "object",
      "required": [
        "evaluator_version",
        "matching_version",
        "coordinate_profile",
        "scope",
        "configuration",
        "reader_configuration",
        "worker_source_sha256",
        "approved_at",
        "approved_by"
      ],
      "properties": {
        "evaluator_version": {
          "const": "invoice-evaluation-2.2.0"
        },
        "matching_version": {
          "const": "page-bbox-positive-iou-cardinality-1.0"
        },
        "coordinate_profile": {
          "const": "normalized-top-left-canonical-1.0"
        },
        "scope": {
          "const": "13_headers+line_items_tax_excluded"
        },
        "configuration": {
          "type": "object"
        },
        "reader_configuration": {
          "type": "object"
        },
        "worker_source_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": "object",
          "required": [
            "TV1",
            "TV2",
            "TV4",
            "TV5"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_sample_id",
          "source_receipt_id",
          "base_document_id",
          "template_id",
          "source",
          "gold",
          "regions",
          "geometry",
          "qa"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "source_sample_id": {
            "type": "string",
            "minLength": 1
          },
          "source_receipt_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_document_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "content_type"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content_type": {
                "enum": [
                  "application/pdf",
                  "image/png",
                  "image/jpeg"
                ]
              }
            }
          },
          "gold": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "regions": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "geometry": {
            "type": "object",
            "required": [
              "profile",
              "page_sizes"
            ],
            "properties": {
              "profile": {
                "const": "normalized-top-left-canonical-1.0"
              },
              "page_sizes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "qa": {
            "type": "object",
            "required": [
              "status",
              "annotated_by",
              "reviewed_by",
              "reviewed_at",
              "source_sha256",
              "gold_sha256",
              "regions_sha256"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PENDING_REVIEW",
                  "VERIFIED"
                ]
              },
              "annotated_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "gold_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "regions_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "split_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "split",
          "base_document_id",
          "template_id",
          "source_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "type": "string",
            "minLength": 1
          },
          "base_document_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
