{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.local/schemas/kie-result.schema.json",
  "title": "KIEResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "extractor", "fields", "duration_ms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "extractor": {"$ref": "#/$defs/componentVersion"},
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant", "date", "total", "invoice_id", "address"],
      "properties": {
        "merchant": {"$ref": "#/$defs/stringField"},
        "date": {"$ref": "#/$defs/dateField"},
        "total": {"$ref": "#/$defs/moneyField"},
        "invoice_id": {"$ref": "#/$defs/stringField"},
        "address": {"$ref": "#/$defs/stringField"}
      }
    },
    "duration_ms": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "componentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "fieldBase": {
      "type": "object",
      "required": ["raw_text", "confidence", "source_block_ids"],
      "properties": {
        "raw_text": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_block_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "stringField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_text", "normalized_value", "confidence", "source_block_ids"],
          "properties": {
            "raw_text": {"type": ["string", "null"]},
            "normalized_value": {"type": ["string", "null"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "source_block_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        }
      ]
    },
    "dateField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_text", "normalized_value", "confidence", "source_block_ids"],
          "properties": {
            "raw_text": {"type": ["string", "null"]},
            "normalized_value": {"type": ["string", "null"], "format": "date"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "source_block_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        }
      ]
    },
    "moneyField": {
      "allOf": [
        {"$ref": "#/$defs/fieldBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_text", "normalized_value", "currency", "confidence", "source_block_ids"],
          "properties": {
            "raw_text": {"type": ["string", "null"]},
            "normalized_value": {"type": ["integer", "null"], "minimum": 0},
            "currency": {"const": "VND"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "source_block_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        }
      ]
    }
  }
}
