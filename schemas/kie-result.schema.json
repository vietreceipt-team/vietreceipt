{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.local/schemas/kie-result.schema.json",
  "title": "VietReceipt KIE Result v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","receipt_id","kie_run_id","source_ocr_run_id","extractor","fields","tax_breakdown","line_items","duration_ms","created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_id": {"type":"string","format":"uuid"},
    "kie_run_id": {"type":"string","format":"uuid"},
    "source_ocr_run_id": {"type":"string","format":"uuid"},
    "extractor": {"$ref":"#/$defs/componentVersion"},
    "fields": {
      "type":"object",
      "additionalProperties":false,
      "required":["invoice_template_number","invoice_symbol","invoice_number","invoice_date","seller_name","seller_tax_id","seller_address","buyer_name","buyer_tax_id","subtotal","tax_amount","total_amount","currency"],
      "properties":{
        "invoice_template_number":{"$ref":"#/$defs/stringField"},
        "invoice_symbol":{"$ref":"#/$defs/stringField"},
        "invoice_number":{"$ref":"#/$defs/stringField"},
        "invoice_date":{"$ref":"#/$defs/dateField"},
        "seller_name":{"$ref":"#/$defs/stringField"},
        "seller_tax_id":{"$ref":"#/$defs/stringField"},
        "seller_address":{"$ref":"#/$defs/stringField"},
        "buyer_name":{"$ref":"#/$defs/stringField"},
        "buyer_tax_id":{"$ref":"#/$defs/stringField"},
        "subtotal":{"$ref":"#/$defs/moneyField"},
        "tax_amount":{"$ref":"#/$defs/moneyField"},
        "total_amount":{"$ref":"#/$defs/moneyField"},
        "currency":{"$ref":"#/$defs/stringField"}
      }
    },
    "tax_breakdown":{"type":"array","items":{"$ref":"#/$defs/taxGroup"}},
    "line_items":{"type":"array","items":{"$ref":"#/$defs/lineItem"}},
    "duration_ms":{"type":"integer","minimum":0},
    "created_at":{"type":"string","format":"date-time"}
  },
  "$defs":{
    "componentVersion":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},
    "valueStatus":{"type":"string","enum":["PRESENT","NOT_PRESENT","UNREADABLE","AMBIGUOUS","UNKNOWN"]},
    "sourceBlockIds":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "stringField":{
      "type":"object","additionalProperties":false,
      "required":["raw_text","predicted_value","normalized_value","value_status","confidence","machine_needs_review","review_reasons","source_block_ids"],
      "properties":{
        "raw_text":{"type":["string","null"]},
        "predicted_value":{"type":["string","null"]},
        "normalized_value":{"type":["string","null"]},
        "value_status":{"$ref":"#/$defs/valueStatus"},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "machine_needs_review":{"type":"boolean"},
        "review_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "source_block_ids":{"$ref":"#/$defs/sourceBlockIds"}
      }
    },
    "dateField":{
      "type":"object","additionalProperties":false,
      "required":["raw_text","predicted_value","normalized_value","value_status","confidence","machine_needs_review","review_reasons","source_block_ids"],
      "properties":{
        "raw_text":{"type":["string","null"]},
        "predicted_value":{"type":["string","null"]},
        "normalized_value":{"type":["string","null"],"format":"date"},
        "value_status":{"$ref":"#/$defs/valueStatus"},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "machine_needs_review":{"type":"boolean"},
        "review_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "source_block_ids":{"$ref":"#/$defs/sourceBlockIds"}
      }
    },
    "moneyField":{
      "type":"object","additionalProperties":false,
      "required":["raw_text","predicted_value","normalized_value","value_status","confidence","machine_needs_review","review_reasons","source_block_ids"],
      "properties":{
        "raw_text":{"type":["string","null"]},
        "predicted_value":{"type":["string","null"]},
        "normalized_value":{"type":["integer","null"],"minimum":0},
        "value_status":{"$ref":"#/$defs/valueStatus"},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "machine_needs_review":{"type":"boolean"},
        "review_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "source_block_ids":{"$ref":"#/$defs/sourceBlockIds"}
      }
    },
    "decimalField":{
      "type":"object","additionalProperties":false,
      "required":["raw_text","predicted_value","normalized_value","value_status","confidence","machine_needs_review","review_reasons","source_block_ids"],
      "properties":{
        "raw_text":{"type":["string","null"]},
        "predicted_value":{"type":["string","null"]},
        "normalized_value":{"type":["number","null"],"minimum":0},
        "value_status":{"$ref":"#/$defs/valueStatus"},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "machine_needs_review":{"type":"boolean"},
        "review_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "source_block_ids":{"$ref":"#/$defs/sourceBlockIds"}
      }
    },
    "taxGroup":{
      "type":"object","additionalProperties":false,
      "required":["rate","taxable_amount","tax_amount"],
      "properties":{
        "rate":{"$ref":"#/$defs/stringField"},
        "taxable_amount":{"$ref":"#/$defs/moneyField"},
        "tax_amount":{"$ref":"#/$defs/moneyField"}
      }
    },
    "lineItem":{
      "type":"object","additionalProperties":false,
      "required":["line_id","description","unit","quantity","unit_price","amount"],
      "properties":{
        "line_id":{"type":"string","minLength":1},
        "description":{"$ref":"#/$defs/stringField"},
        "unit":{"$ref":"#/$defs/stringField"},
        "quantity":{"$ref":"#/$defs/decimalField"},
        "unit_price":{"$ref":"#/$defs/moneyField"},
        "amount":{"$ref":"#/$defs/moneyField"}
      }
    }
  }
}