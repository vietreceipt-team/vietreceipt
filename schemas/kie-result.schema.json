{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.example/schemas/kie-result.schema.json",
  "title": "VietReceipt KIE Result",
  "description": "Immutable machine output of one KIE run over one OCR run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "kie_run_id", "source_ocr_run_id", "extractor_name", "extractor_version", "duration_ms", "created_at", "fields"],
  "properties": {
    "schema_version": { "const": "1.3" },
    "receipt_id": { "$ref": "#/$defs/uuid" },
    "kie_run_id": { "$ref": "#/$defs/uuid" },
    "source_ocr_run_id": { "$ref": "#/$defs/uuid" },
    "extractor_name": { "type": "string", "minLength": 1 },
    "extractor_version": { "type": "string", "minLength": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "review_policy_version": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant_name", "receipt_date", "total_amount", "invoice_id", "merchant_address"],
      "properties": {
        "merchant_name": { "$ref": "#/$defs/string_field" },
        "receipt_date": { "$ref": "#/$defs/date_field" },
        "total_amount": { "$ref": "#/$defs/total_field" },
        "invoice_id": { "$ref": "#/$defs/string_field" },
        "merchant_address": { "$ref": "#/$defs/string_field" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "value_status": { "enum": ["PRESENT", "NOT_PRESENT", "UNREADABLE", "AMBIGUOUS", "UNKNOWN"] },
    "review_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["NO_CANDIDATE", "LOW_CONFIDENCE", "MULTIPLE_CANDIDATES", "AMBIGUOUS_FORMAT", "UNREADABLE_SOURCE", "UNSUPPORTED_CURRENCY", "NEGATIVE_AMOUNT", "MISSING_DATE_COMPONENT", "UNSUPPORTED_TWO_DIGIT_YEAR", "SOURCE_ROLE_UNCLEAR", "NORMALIZATION_FAILED"] },
        "message": { "type": "string" }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "version"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "field_base": {
      "type": "object",
      "required": ["raw_text", "predicted_value", "normalized_value", "value_status", "confidence", "machine_needs_review", "review_reasons", "source_block_ids"],
      "properties": {
        "raw_text": { "type": ["string", "null"] },
        "predicted_value": { "type": ["string", "null"] },
        "value_status": { "$ref": "#/$defs/value_status" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "machine_needs_review": { "type": "boolean" },
        "review_reasons": { "type": "array", "items": { "$ref": "#/$defs/review_reason" } },
        "normalization": { "$ref": "#/$defs/normalization" },
        "source_block_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "machine_needs_review": { "const": true } }, "required": ["machine_needs_review"] },
          "then": { "properties": { "review_reasons": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value_status": { "const": "PRESENT" } }, "required": ["value_status"] },
          "then": {
            "properties": {
              "predicted_value": { "type": "string", "minLength": 1 },
              "normalized_value": { "not": { "type": "null" } },
              "source_block_ids": { "minItems": 1 }
            },
            "required": ["normalization"]
          }
        },
        {
          "if": { "properties": { "value_status": { "enum": ["NOT_PRESENT", "UNREADABLE", "AMBIGUOUS", "UNKNOWN"] } }, "required": ["value_status"] },
          "then": { "properties": { "normalized_value": { "type": "null" } } }
        },
        {
          "if": { "properties": { "value_status": { "enum": ["NOT_PRESENT", "UNKNOWN"] } }, "required": ["value_status"] },
          "then": { "properties": { "predicted_value": { "type": "null" } } }
        },
        {
          "if": { "properties": { "value_status": { "enum": ["NOT_PRESENT", "UNREADABLE", "AMBIGUOUS", "UNKNOWN"] } }, "required": ["value_status"] },
          "then": { "properties": { "machine_needs_review": { "const": true } } }
        },
        {
          "if": { "properties": { "source_block_ids": { "minItems": 1 } }, "required": ["source_block_ids"] },
          "then": { "properties": { "raw_text": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "source_block_ids": { "maxItems": 0 } }, "required": ["source_block_ids"] },
          "then": { "properties": { "raw_text": { "type": "null" } } }
        },
        {
          "if": { "properties": { "normalized_value": { "not": { "type": "null" } } }, "required": ["normalized_value"] },
          "then": { "required": ["normalization"] }
        }
      ]
    },
    "string_field": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/field_base" },
        { "type": "object", "properties": { "normalized_value": { "type": ["string", "null"] } } }
      ]
    },
    "date_field": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/field_base" },
        { "type": "object", "properties": { "normalized_value": { "type": ["string", "null"], "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } }
      ]
    },
    "total_field": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/field_base" },
        { "type": "object", "required": ["currency"], "properties": { "normalized_value": { "type": ["integer", "null"], "minimum": 0 }, "currency": { "const": "VND" } } }
      ]
    }
  },
  "x-vietreceipt-invariants": [
    "a completed KIE run contains exactly the five canonical fields",
    "all source_block_ids belong to source_ocr_run_id",
    "raw_text joins unmodified source block text by reading_order with newline",
    "review_policy_version is present when a versioned policy makes a review decision",
    "reruns create a new kie_run_id"
  ]
}
