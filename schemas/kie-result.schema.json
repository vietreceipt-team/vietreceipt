{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.local/schemas/kie-result.schema.json",
  "title": "KIEResult v1.3 aligned with KIE field contract v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "kie_run_id",
    "source_ocr_run_id",
    "extractor",
    "fields",
    "duration_ms",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.3"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "kie_run_id": {"type": "string", "format": "uuid"},
    "source_ocr_run_id": {"type": "string", "format": "uuid"},
    "extractor": {"$ref": "#/$defs/componentVersion"},
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant_name", "receipt_date", "total_amount", "invoice_id", "merchant_address"],
      "properties": {
        "merchant_name": {"$ref": "#/$defs/stringField"},
        "receipt_date": {"$ref": "#/$defs/dateField"},
        "total_amount": {"$ref": "#/$defs/moneyField"},
        "invoice_id": {"$ref": "#/$defs/stringField"},
        "merchant_address": {"$ref": "#/$defs/stringField"}
      }
    },
    "duration_ms": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "componentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "normalizationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "version"],
      "properties": {
        "rule": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "valueStatus": {
      "type": "string",
      "enum": ["PRESENT", "NOT_PRESENT", "UNREADABLE", "AMBIGUOUS", "UNKNOWN"]
    },
    "reviewReason": {
      "type": "string",
      "enum": [
        "NO_CANDIDATE",
        "LOW_CONFIDENCE",
        "MULTIPLE_CANDIDATES",
        "AMBIGUOUS_FORMAT",
        "UNREADABLE_SOURCE",
        "UNSUPPORTED_CURRENCY",
        "NEGATIVE_AMOUNT",
        "MISSING_DATE_COMPONENT",
        "UNSUPPORTED_TWO_DIGIT_YEAR",
        "SOURCE_ROLE_UNCLEAR",
        "NORMALIZATION_FAILED"
      ]
    },
    "sourceBlockIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "machineRules": {
      "allOf": [
        {
          "if": {"type": "object", "properties": {"machine_needs_review": {"const": true}}},
          "then": {
            "type": "object",
            "required": ["review_policy_version"],
            "properties": {
              "review_reasons": {"type": "array", "minItems": 1},
              "review_policy_version": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "type": "object",
            "properties": {"review_reasons": {"type": "array", "maxItems": 0}}
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {"source_block_ids": {"type": "array", "minItems": 1}}
          },
          "then": {
            "type": "object",
            "properties": {"raw_text": {"type": "string", "minLength": 1}}
          },
          "else": {
            "type": "object",
            "properties": {"raw_text": {"type": "null"}}
          }
        },
        {
          "if": {"type": "object", "properties": {"value_status": {"const": "UNKNOWN"}}},
          "then": {
            "type": "object",
            "properties": {
              "predicted_value": {"type": "null"},
              "normalized_value": {"type": "null"}
            }
          }
        }
      ]
    },
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "predicted_value",
        "normalized_value",
        "value_status",
        "confidence",
        "machine_needs_review",
        "review_reasons",
        "source_block_ids"
      ],
      "properties": {
        "raw_text": {"type": ["string", "null"], "minLength": 1},
        "predicted_value": {"type": ["string", "null"], "minLength": 1},
        "normalized_value": {"type": ["string", "null"], "minLength": 1},
        "normalization": {
          "oneOf": [{"$ref": "#/$defs/normalizationProvenance"}, {"type": "null"}]
        },
        "value_status": {"$ref": "#/$defs/valueStatus"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "machine_needs_review": {"type": "boolean"},
        "review_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reviewReason"}
        },
        "review_policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_block_ids": {"$ref": "#/$defs/sourceBlockIds"}
      },
      "allOf": [
        {"$ref": "#/$defs/machineRules"},
        {
          "if": {"type": "object", "properties": {"value_status": {"const": "PRESENT"}}},
          "then": {
            "type": "object",
            "required": ["normalization"],
            "properties": {
              "raw_text": {"type": "string", "minLength": 1},
              "predicted_value": {"type": "string", "minLength": 1},
              "normalized_value": {"type": "string", "minLength": 1},
              "normalization": {"$ref": "#/$defs/normalizationProvenance"},
              "source_block_ids": {"type": "array", "minItems": 1}
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "normalized_value": {"type": "null"},
              "normalization": {"type": "null"},
              "machine_needs_review": {"const": true}
            }
          }
        }
      ]
    },
    "dateField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "predicted_value",
        "normalized_value",
        "value_status",
        "confidence",
        "machine_needs_review",
        "review_reasons",
        "source_block_ids"
      ],
      "properties": {
        "raw_text": {"type": ["string", "null"], "minLength": 1},
        "predicted_value": {"type": ["string", "null"], "minLength": 1},
        "normalized_value": {"type": ["string", "null"], "format": "date"},
        "normalization": {
          "oneOf": [{"$ref": "#/$defs/normalizationProvenance"}, {"type": "null"}]
        },
        "value_status": {"$ref": "#/$defs/valueStatus"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "machine_needs_review": {"type": "boolean"},
        "review_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reviewReason"}
        },
        "review_policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_block_ids": {"$ref": "#/$defs/sourceBlockIds"}
      },
      "allOf": [
        {"$ref": "#/$defs/machineRules"},
        {
          "if": {"type": "object", "properties": {"value_status": {"const": "PRESENT"}}},
          "then": {
            "type": "object",
            "required": ["normalization"],
            "properties": {
              "raw_text": {"type": "string", "minLength": 1},
              "predicted_value": {"type": "string", "minLength": 1},
              "normalized_value": {"type": "string", "format": "date"},
              "normalization": {"$ref": "#/$defs/normalizationProvenance"},
              "source_block_ids": {"type": "array", "minItems": 1}
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "normalized_value": {"type": "null"},
              "normalization": {"type": "null"},
              "machine_needs_review": {"const": true}
            }
          }
        }
      ]
    },
    "moneyField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "predicted_value",
        "normalized_value",
        "currency",
        "value_status",
        "confidence",
        "machine_needs_review",
        "review_reasons",
        "source_block_ids"
      ],
      "properties": {
        "raw_text": {"type": ["string", "null"], "minLength": 1},
        "predicted_value": {"type": ["string", "null"], "minLength": 1},
        "normalized_value": {"type": ["integer", "null"], "minimum": 0},
        "normalization": {
          "oneOf": [{"$ref": "#/$defs/normalizationProvenance"}, {"type": "null"}]
        },
        "currency": {"const": "VND"},
        "value_status": {"$ref": "#/$defs/valueStatus"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "machine_needs_review": {"type": "boolean"},
        "review_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reviewReason"}
        },
        "review_policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_block_ids": {"$ref": "#/$defs/sourceBlockIds"}
      },
      "allOf": [
        {"$ref": "#/$defs/machineRules"},
        {
          "if": {"type": "object", "properties": {"value_status": {"const": "PRESENT"}}},
          "then": {
            "type": "object",
            "required": ["normalization"],
            "properties": {
              "raw_text": {"type": "string", "minLength": 1},
              "predicted_value": {"type": "string", "minLength": 1},
              "normalized_value": {"type": "integer", "minimum": 0},
              "normalization": {"$ref": "#/$defs/normalizationProvenance"},
              "source_block_ids": {"type": "array", "minItems": 1}
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "normalized_value": {"type": "null"},
              "normalization": {"type": "null"},
              "machine_needs_review": {"const": true}
            }
          }
        }
      ]
    }
  }
}
