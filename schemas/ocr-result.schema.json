{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.local/schemas/ocr-result.schema.json",
  "title": "OCRResult v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "ocr_run_id",
    "engine",
    "image",
    "blocks",
    "average_confidence",
    "duration_ms"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "ocr_run_id": {"type": "string", "format": "uuid"},
    "engine": {"$ref": "#/$defs/componentVersion"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1}
      }
    },
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/ocrBlock"}
    },
    "average_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "duration_ms": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "componentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ocrBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "text",
        "confidence",
        "polygon",
        "reading_order"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "polygon": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/point"}
        },
        "reading_order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
