{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.example/schemas/ocr-result.schema.json",
  "title": "VietReceipt OCR Result",
  "description": "Immutable output of one OCR run. Reprocessing creates a new ocr_run_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "ocr_run_id", "engine_name", "engine_version", "image_width_px", "image_height_px", "duration_ms", "created_at", "blocks"],
  "properties": {
    "schema_version": { "const": "1.3" },
    "receipt_id": { "$ref": "#/$defs/uuid" },
    "ocr_run_id": { "$ref": "#/$defs/uuid" },
    "engine_name": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "image_width_px": { "type": "integer", "minimum": 1 },
    "image_height_px": { "type": "integer", "minimum": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/ocr_block" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "coordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" } }
    },
    "ocr_block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "text", "polygon", "confidence", "reading_order"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "polygon": {
          "description": "Four normalized points ordered top-left, top-right, bottom-right, bottom-left after EXIF orientation.",
          "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/point" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reading_order": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "x-vietreceipt-invariants": [
    "ocr_run_id identifies an immutable run; reruns create a new identifier",
    "block_id is unique within an OCR run",
    "reading_order is unique and zero-based within an OCR run",
    "OCR block contents are immutable after persistence"
  ]
}
