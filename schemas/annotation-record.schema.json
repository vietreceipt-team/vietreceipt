{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vietreceipt.local/schemas/annotation-record.schema.json",
  "title":"VietReceipt mapped/synthetic ground truth v2.0",
  "type":"object",
  "additionalProperties":false,
  "required":["annotation_schema_version","receipt_id","dataset_family","dataset_snapshot","sample_id","synthetic","split","mapping_version","fields","line_items"],
  "properties":{
    "annotation_schema_version":{"const":"2.0"},
    "receipt_id":{"type":"string","format":"uuid"},
    "dataset_family":{"type":"string","minLength":1},
    "dataset_snapshot":{"type":"string","minLength":1},
    "sample_id":{"type":"string","minLength":1},
    "synthetic":{"type":"boolean"},
    "split":{"type":"string","enum":["train","validation","test","benchmark"]},
    "mapping_version":{"type":"string","minLength":1},
    "template_id":{"type":["string","null"]},
    "parent_sample_id":{"type":["string","null"]},
    "fields":{"type":"object","additionalProperties":{"$ref":"#/$defs/annotationField"}},
    "line_items":{"type":"array","items":{"$ref":"#/$defs/annotationLine"}}
  },
  "$defs":{
    "annotationStatus":{"type":"string","enum":["PRESENT","NOT_PRESENT","UNREADABLE","AMBIGUOUS","UNKNOWN"]},
    "annotationField":{
      "type":"object","additionalProperties":false,
      "required":["annotation_status","raw_value","normalized_value","source_block_ids"],
      "properties":{
        "annotation_status":{"$ref":"#/$defs/annotationStatus"},
        "raw_value":{"type":["string","number","integer","null"]},
        "normalized_value":{"type":["string","number","integer","null"]},
        "source_block_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "annotationLine":{
      "type":"object","additionalProperties":false,
      "required":["line_id","description","unit","quantity","unit_price","amount"],
      "properties":{
        "line_id":{"type":"string","minLength":1},
        "description":{"$ref":"#/$defs/annotationField"},
        "unit":{"$ref":"#/$defs/annotationField"},
        "quantity":{"$ref":"#/$defs/annotationField"},
        "unit_price":{"$ref":"#/$defs/annotationField"},
        "amount":{"$ref":"#/$defs/annotationField"}
      }
    }
  }
}