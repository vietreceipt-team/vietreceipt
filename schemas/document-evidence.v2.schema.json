{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietreceipt.local/schemas/document-evidence.v2.schema.json",
  "title": "Document Evidence 2.0 (TV5 compatible envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "ocr_run_id", "pages"],
  "properties": {
    "schema_version": {"const": "document-2.0"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "ocr_run_id": {"type": "string", "format": "uuid"},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["page_index", "evidence"],
        "properties": {
          "page_index": {"type": "integer", "minimum": 0},
          "evidence": {"$ref": "ocr-result.schema.json"}
        }
      }
    }
  }
}
