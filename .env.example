# Application
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
DATABASE_URL=postgresql+psycopg://vietreceipt:vietreceipt@postgres:5432/vietreceipt

# Background jobs
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Private object storage
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=vietreceipt
STORAGE_SECURE=false

# Backend-2 internal storage/development configuration
STORAGE_BACKEND=filesystem
STORAGE_FILESYSTEM_ROOT=.data/receipt-images
STORAGE_REGION=
MAX_IMAGE_PIXELS=40000000

# Upload policy
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional external adapters. Leave empty for in-process Python adapters.
OCR_SERVICE_URL=
KIE_SERVICE_URL=

# Processing
OCR_TIMEOUT_SECONDS=60
PROCESSING_MAX_RETRIES=2