# Application
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL container bootstrap only. Backend and Worker must not read these
# values directly; DATABASE_URL below is their database source of truth.
POSTGRES_DB=vietreceipt
POSTGRES_USER=vietreceipt
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql+psycopg://vietreceipt:local_dev_only_change_me@postgres:5432/vietreceipt

# Background jobs
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Receipt-image storage. The W1 runtime uses the shared filesystem adapter.
STORAGE_BACKEND=s3
STORAGE_FILESYSTEM_ROOT=.data/receipt-images

# MinIO is provisioned for local infrastructure readiness, but is not the W1
# runtime adapter. Switching the application to MinIO later uses
# STORAGE_BACKEND=s3; "minio" is not a valid backend value.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=vietreceipt_local
STORAGE_SECRET_KEY=local_dev_only_change_me
STORAGE_BUCKET=vietreceipt
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# Upload policy
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional external adapters. Leave empty for in-process Python adapters.
OCR_SERVICE_URL=
KIE_SERVICE_URL=

# Processing
OCR_TIMEOUT_SECONDS=60
KIE_TIMEOUT_SECONDS=60
PROCESSING_MAX_RETRIES=2
PROCESSING_STALE_AFTER_SECONDS=900
PROCESSING_REAPER_INTERVAL_SECONDS=60

# PaddlePaddle 3.0.0 worker runtime. The amd64 default also supports local
# development on Apple Silicon through Docker emulation. Leave empty to keep
# the default; override only with a platform supported by the pinned wheel.
WORKER_PLATFORM=linux/amd64

# Compose host port overrides for the backend/frontend containers.
BACKEND_PORT=8000
FRONTEND_PORT=3000
