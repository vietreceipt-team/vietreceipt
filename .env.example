# Cơ sở dữ liệu
DATABASE_URL=

# Khóa bí mật của ứng dụng
SECRET_KEY=

# Cấu hình lưu trữ tệp (shared names follow the canonical Backend convention)
STORAGE_BACKEND=filesystem
STORAGE_FILESYSTEM_ROOT=.data/receipt-images
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=vietreceipt
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SECURE=true
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Internal decoder-safety limit; not a public API policy.
MAX_IMAGE_PIXELS=40000000

# Cấu hình OCR nếu cần
OCR_SERVICE_URL=

# Môi trường chạy
APP_ENV=development
